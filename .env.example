# Copy to .env (next to package.json). .env is gitignored.

# Absolute path to the vault folder (the one containing .obsidian/).
# Several vaults: separate them with ":" (";" on Windows); one process then syncs them all.
VAULT_PATH=

# Optional. Leave empty to use the system git credential helper (recommended).
# Otherwise: a fine-grained GitHub token scoped to the vault repo, "Contents: Read and write" only.
GITHUB_TOKEN=

# Optional overrides.
# DEBOUNCE_SECONDS=30
# PULL_INTERVAL_SECONDS=300
